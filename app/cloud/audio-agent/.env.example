AUDIO_AGENT_PORT=18987
AUDIO_AGENT_STT_PROVIDER=elevenlabs
AUDIO_AGENT_PUBLIC_BASE_URL=http://YOUR_SERVER_PUBLIC_IP:18987
AUDIO_AGENT_DATA_DIR=/opt/audio-agent/data
AUDIO_AGENT_LOCAL_AUDIO_DIR=/opt/audio-agent/local-audio
FFMPEG_PATH=/usr/local/bin/ffmpeg

# Meeting transcription. Keep this key on the server; never place it in the
# Android app, EXPO_PUBLIC_* variables, Gradle properties, or committed files.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_ENDPOINT=https://api.elevenlabs.io/v1/speech-to-text
ELEVENLABS_STT_MODEL=scribe_v2
# Leave empty for automatic language detection.
ELEVENLABS_STT_LANGUAGE=
ELEVENLABS_STT_DIARIZE=1
ELEVENLABS_STT_TAG_AUDIO_EVENTS=1
# Enable after enrolling known speakers in the ElevenLabs workspace.
ELEVENLABS_STT_USE_SPEAKER_LIBRARY=0
# Optional expected maximum (1-32). Leave empty to auto-detect.
ELEVENLABS_STT_NUM_SPEAKERS=
ELEVENLABS_STT_TIMEOUT_MS=300000

# New console: use API key. Legacy console: leave this empty and set both
# VOLCENGINE_ASR_APP_ID and VOLCENGINE_ASR_ACCESS_TOKEN instead.
VOLCENGINE_ASR_API_KEY=
VOLCENGINE_ASR_APP_ID=
VOLCENGINE_ASR_ACCESS_TOKEN=
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.auc
VOLCENGINE_ASR_LANGUAGE=zh-CN
VOLCENGINE_ASR_FLASH_ENDPOINT=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
VOLCENGINE_ASR_FLASH_RESOURCE_ID=volc.seedasr.auc

# 悬浮窗：大模型流式语音识别（语音→文字，非 S2S）
# 小时版 Resource ID 通常为 volc.seedasr.sauc.duration
VOLCENGINE_SAUC_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
VOLCENGINE_SAUC_RESOURCE_ID=volc.seedasr.sauc.duration

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Agent Flow image generation (SiliconFlow images API; reuses DEEPSEEK_API_KEY).
SILICONFLOW_IMAGE_MODEL=Kwai-Kolors/Kolors
SILICONFLOW_IMAGE_SIZE=1024x1024
SILICONFLOW_IMAGE_STEPS=20
